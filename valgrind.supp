# Suppressions for leaks inside PipeWire's ALSA-compat PCM plugin
# (libasound_module_pcm_pipewire / libpipewire) during snd_pcm_open()
# for the "pipewire" device and its later snd_pcm_close(). Verified in
# isolation: a program that does nothing but br_audio_init()+br_audio_shutdown()
# reproduces the exact same leak totals as the full game, so these are not
# bugs in borka's own code.

{
   pipewire-alsa-open-close-leak-01
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:strdup
   obj:*
   obj:*
   obj:*
   fun:snd_pcm_open_conf
   fun:snd_pcm_open_noupdate
   fun:snd_pcm_open
   fun:open_pcm
   fun:br_audio_init
}
{
   pipewire-alsa-open-close-leak-02
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   fun:strdup
   obj:*
   obj:*
   obj:*
   obj:*
   fun:snd_pcm_open_conf
   fun:snd_pcm_open_noupdate
   fun:snd_pcm_open
   fun:open_pcm
   fun:br_audio_init
}
{
   pipewire-alsa-open-close-leak-03
   Memcheck:Leak
   match-leak-kinds: indirect
